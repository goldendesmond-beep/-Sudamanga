# Inkstone Runtime Configuration
# Default policy: ZERO_COST_ONLY=true (zero-cost models and local heuristics)
# Credentials are user-configurable and optional. Never commit actual secret keys.

# Optional: Agnes API Key for cloud multimodal generation
AGNES_API_KEY=

# Optional: Gemini API Key for server-side assistance
GEMINI_API_KEY=

# Server Port
PORT=3000

# Strict Zero-Cost Enforcement (true by default)
ZERO_COST_ONLY=true
